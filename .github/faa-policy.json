{
  "version": "pilot-1",
  "mode": "audit",
  "mandatorySignals": ["authentication-authorization", "secrets-vault", "previous-incident-area"],
  "mandatoryInternetApi": true,
  "requiredLabels": ["faa-required"],
  "application": {
    "tier": "tier-2",
    "internetFacing": true,
    "dataClassification": "internal",
    "classificationStatus": "pilot-assumption"
  },
  "thresholds": { "recommended": 5, "mandatory": 9 },
  "changeSize": { "highRisk": 500, "general": 1500 },
  "scores": {
    "tier-1": 5,
    "internet-facing": 4,
    "restricted-data": 4,
    "confidential-data": 2,
    "authentication-authorization": 5,
    "secrets-vault": 5,
    "new-api": 4,
    "external-integration": 4,
    "sensitive-business-logic": 4,
    "predominant-ai": 2,
    "significant-ai": 1,
    "unreviewed-ai": 3,
    "large-change": 2,
    "new-dependency": 2,
    "previous-incident-area": 3
  },
  "paths": {
    "authentication-authorization": [
      "(^|/)(auth|authentication|authorization|identity|permissions|roles|claims)/",
      "^packages/api/src/services/(Auth|Mfa|User|Verification)Service\\.ts$",
      "^packages/api/src/web/(default|user|userPublic)\\.ts$",
      "^packages/api/src/middleware/(authenticateJwt|requireAuth|requireRole)\\.ts$",
      "^packages/api/src/config/(passport|security)\\.ts$",
      "^packages/api/src/utils/jwt\\.ts$",
      "^packages/api/src/api/v3/(account|mfa|roles|users)\\.ts$",
      "^packages/api/src/(models/(Authority|User|UserAuthority|RefreshToken)|repositories/(RefreshToken|Role|User)Repository)\\.ts$"
    ],
    "secrets-vault": [
      "(^|/)(secrets|vault)/",
      "(credential|keyvault|key-vault|secret|token)[^/]*\\.(ts|tsx|js|mjs|json)$",
      "^packages/api/src/(utils/(jwt|crypto)|config/env)\\.ts$",
      "(^|/)\\.env($|\\.)"
    ],
    "new-api": [
      "^packages/api/src/api/v3/.*\\.ts$",
      "(^|/)(openapi|swagger)[^/]*\\.(json|ya?ml)$"
    ],
    "external-integration": [
      "^packages/api/src/services/(Email|Sms)Service\\.ts$",
      "^packages/agent/src/.*(tool|connector|client|provider)[^/]*\\.(ts|js)$"
    ],
    "sensitive-business-logic": [
      "^packages/api/src/services/(Order|User|Verification)Service\\.ts$",
      "^packages/api/src/api/v3/(orders|crypto)\\.ts$"
    ],
    "previous-incident-area": []
  },
  "dependencyPatterns": [
    "(^|/)(package\\.json|package-lock\\.json|npm-shrinkwrap\\.json|yarn\\.lock|pnpm-lock\\.yaml)$"
  ],
  "nonExecutablePatterns": [
    "\\.(md|txt|rst|csv|svg|png|jpe?g|gif|ico|webp|pdf|zip|fpr|sarif|sqlite|db|log)$",
    "(^|/)(node_modules|dist|build|coverage|specs|data|logs)/",
    "^(Src|fortify-presales)/",
    "(^|/)(package-lock\\.json|npm-shrinkwrap\\.json|yarn\\.lock|pnpm-lock\\.yaml)$"
  ]
}
